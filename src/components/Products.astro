---
const products = [
  {
    id: 'crm',
    title: 'CRM',
    subtitle: 'Customer Relationship Management',
    description: 'Gestiona tus relaciones con clientes de forma eficiente. Centraliza información de contacto, historial de ventas, seguimiento de oportunidades y automatiza procesos comerciales.',
    icon: '👥',
    features: ['Gestión de contactos', 'Pipeline de ventas', 'Automatización de seguimientos', 'Reportes y analytics', 'Integración con email', 'Mobile friendly'],
    color: 'from-blue-500 to-cyan-500'
  },
  {
    id: 'lms',
    title: 'LMS',
    subtitle: 'Learning Management System',
    description: 'Plataforma completa para crear, gestionar y entregar cursos online. Ideal para empresas que capacitan equipos o instituciones educativas.',
    icon: '📚',
    features: ['Creación de cursos', 'Evaluaciones y certificados', 'Seguimiento de progreso', 'Foros y comunidades', 'Gamificación', 'Multi-idioma'],
    color: 'from-purple-500 to-pink-500'
  },
  {
    id: 'ops',
    title: 'OPS',
    subtitle: 'Operations Management System',
    description: 'Optimiza las operaciones de tu negocio con un sistema integral que gestiona inventario, producción, logística y recursos de forma coordinada.',
    icon: '⚙️',
    features: ['Gestión de inventario', 'Control de producción', 'Logística y distribución', 'Optimización de recursos', 'Reportes operativos', 'Integración con otros sistemas'],
    color: 'from-orange-500 to-red-500'
  },
  {
    id: 'erp',
    title: 'ERP',
    subtitle: 'Enterprise Resource Planning',
    description: 'Sistema integral para gestionar todos los recursos de tu empresa: finanzas, recursos humanos, inventario, ventas y más, todo en un solo lugar.',
    icon: '🏢',
    features: ['Gestión financiera', 'Control de inventario', 'Recursos humanos', 'Ventas y compras', 'Reportes ejecutivos', 'Escalabilidad empresarial'],
    color: 'from-indigo-500 to-blue-500'
  },
  {
    id: 'hrm',
    title: 'HRM',
    subtitle: 'Human Resource Management',
    description: 'Gestiona el talento humano de tu empresa: reclutamiento, nómina, evaluaciones de desempeño, capacitación y desarrollo de equipos.',
    icon: '👔',
    features: ['Reclutamiento y selección', 'Gestión de nómina', 'Evaluaciones de desempeño', 'Capacitación y desarrollo', 'Asistencia y horarios', 'Beneficios y prestaciones'],
    color: 'from-green-500 to-emerald-500'
  },
  {
    id: 'pos',
    title: 'POS',
    subtitle: 'Point of Sale',
    description: 'Sistema de punto de venta completo para tiendas físicas y online. Gestiona ventas, inventario, clientes y reportes en tiempo real.',
    icon: '💳',
    features: ['Ventas en punto de venta', 'Gestión de inventario', 'Múltiples métodos de pago', 'Facturación electrónica', 'Reportes de ventas', 'Integración con e-commerce'],
    color: 'from-teal-500 to-cyan-500'
  },
  {
    id: 'inventory',
    title: 'Inventory Management',
    subtitle: 'Sistema de Inventario',
    description: 'Control total de tu inventario con seguimiento en tiempo real, alertas de stock bajo, gestión de proveedores y reportes detallados.',
    icon: '📦',
    features: ['Control de stock en tiempo real', 'Alertas automáticas', 'Gestión de proveedores', 'Códigos de barras', 'Reportes de inventario', 'Multi-almacén'],
    color: 'from-amber-500 to-orange-500'
  },
  {
    id: 'project',
    title: 'Project Management',
    subtitle: 'Gestión de Proyectos',
    description: 'Organiza, planifica y ejecuta proyectos de forma eficiente. Gestiona tareas, recursos, tiempos y colaboración en equipo.',
    icon: '📊',
    features: ['Gestión de tareas', 'Planificación de recursos', 'Seguimiento de tiempos', 'Colaboración en equipo', 'Reportes de progreso', 'Integración con herramientas'],
    color: 'from-violet-500 to-purple-500'
  },
  {
    id: 'appointment',
    title: 'Sistema de Agendamiento',
    subtitle: 'Appointment Scheduling System',
    description: 'Gestiona citas y reservas de forma eficiente. Calendarios interactivos, recordatorios automáticos y gestión de disponibilidad en tiempo real.',
    icon: '📅',
