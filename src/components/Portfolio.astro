<style>
  .animate-infinite-scroll {
    animation: infinite-scroll 40s linear infinite;
  }

  @keyframes infinite-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

<style>
  .embla {
    width: 100%;
  }

  .embla__viewport {
    width: 100%;
    overflow: hidden;
  }

  .embla__container {
    display: flex;
    width: 100%;
  }

  .embla__slide {
    flex: 0 0 85%;
    min-width: 0;
    padding: 0 1rem;
  }

  @media (min-width: 768px) {
    .embla__slide {
      flex: 0 0 70%;
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .embla__slide {
      flex: 0 0 60%;
      padding: 0 2rem;
    }
  }

  /* En mobile, deshabilitar scroll en iframes y hacer overlay clickeable */
  @media (max-width: 768px) {
    .portfolio-iframe {
      pointer-events: none;
      overflow: hidden;
    }
  }

  /* En desktop, permitir interacción con iframes */
  @media (min-width: 768px) {
    .portfolio-iframe {
      pointer-events: auto;
    }
  }

  .portfolio-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    cursor: pointer;
    display: block;
  }
</style>

<script>
  // Lazy load Embla solo cuando sea necesario
  let emblaLoaded = false;
  let emblaObserver: IntersectionObserver | null = null;
  
  async function initPortfolioCarousel() {
    if (emblaLoaded) return;
    emblaLoaded = true;
    
    const EmblaCarousel = (await import("embla-carousel")).default;
    
    const emblaNode = document.getElementById("embla-portfolio");
    if (!emblaNode) return;

    const viewport = emblaNode.querySelector(".embla__viewport") as HTMLElement;
    if (!viewport) return;

    const embla = EmblaCarousel(viewport, {
      align: "center",
      slidesToScroll: 1,
      containScroll: "trimSnaps",
      loop: true,
      dragFree: true, // Desactivar drag libre para que centre automáticamente
    });

    // Función para cargar iframes lazy
    function loadIframe(iframe: HTMLIFrameElement) {
      const dataSrc = iframe.getAttribute("data-src") || iframe.src;
      if (dataSrc) {
        const placeholder = iframe.parentElement?.querySelector('.iframe-placeholder');
        
        iframe.onload = () => {
          iframe.classList.remove('opacity-0');
          if (placeholder) {
            (placeholder as HTMLElement).style.display = 'none';
          }
        };

        // Si ya tiene src (como el primero), verificar si ya cargó
        if (iframe.src) {
          try {
            if (iframe.contentWindow && iframe.contentWindow.document.readyState === 'complete') {
              iframe.classList.remove('opacity-0');
              if (placeholder) (placeholder as HTMLElement).style.display = 'none';
            }
          } catch (e) {
             // CORS error es normal si ya cargó de otro dominio
             iframe.classList.remove('opacity-0');
             if (placeholder) (placeholder as HTMLElement).style.display = 'none';
          }
        }

        if (iframe.getAttribute("data-src")) {
          iframe.src = dataSrc;
          iframe.removeAttribute("data-src");
        }
      }
    }

    // Cargar iframes cuando se vuelvan visibles
    function loadVisibleIframes() {
      if (!emblaNode) return;
      const slides = emblaNode.querySelectorAll(".embla__slide");
      const selectedIndex = embla.selectedScrollSnap();
      
      // Cargar el slide actual y los adyacentes (hasta 2 a cada lado)
      for (let offset = -2; offset <= 2; offset++) {
        let index = selectedIndex + offset;
        
        // Manejar loop del carousel
        if (index < 0) {
          index = slides.length + index;
        } else if (index >= slides.length) {
          index = index - slides.length;
        }
        
        if (index >= 0 && index < slides.length) {
          const slide = slides[index] as HTMLElement;
          const iframe = slide.querySelector("iframe");
          if (iframe) {
            loadIframe(iframe);
          }
        }
      }
    }

    // Start from the first slide (index 0)
    embla.scrollTo(0);

    // Esperar a que el carousel esté listo antes de cargar iframes
    setTimeout(() => {
      loadVisibleIframes();
    }, 100);

    // Cargar iframes cuando cambie el slide
    embla.on("select", () => {
      loadVisibleIframes();
    });

    const prevButton = emblaNode.querySelector(".embla__prev");
    const nextButton = emblaNode.querySelector(".embla__next");

    if (prevButton) {
      prevButton.addEventListener("click", () => embla.scrollPrev());
    }

    if (nextButton) {
      nextButton.addEventListener("click", () => embla.scrollNext());
    }

    // Auto-scroll cada 5 segundos
    let autoplayInterval: ReturnType<typeof setInterval> | null = null;
    let isUserInteracting = false;

    function startAutoplay() {
      if (autoplayInterval) return;
      autoplayInterval = setInterval(() => {
        if (!isUserInteracting) {
          embla.scrollNext();
        }
      }, 6500); 
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
    }

    // Detectar interacción del usuario
    embla.on("pointerDown", () => {
      isUserInteracting = true;
      stopAutoplay();
    });

    embla.on("pointerUp", () => {
      setTimeout(() => {
        isUserInteracting = false;
        startAutoplay();
      }, 3000); // Reanudar después de 3 segundos de inactividad
    });

    // Iniciar autoplay
    startAutoplay();

      // Pausar cuando la ventana no está visible
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      });
      
      // Limpiar observer
      if (emblaObserver) {
        emblaObserver.disconnect();
        emblaObserver = null;
      }
  }
  
  // IntersectionObserver para lazy loading
  document.addEventListener("DOMContentLoaded", () => {
    const emblaNode = document.getElementById("embla-portfolio");
    if (!emblaNode) return;
    
    emblaObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          initPortfolioCarousel();
        }
      });
    }, {
      rootMargin: '200px'
    });
    
    emblaObserver.observe(emblaNode);
  });
</script>
