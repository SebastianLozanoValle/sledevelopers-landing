<script>
  // Lazy load GSAP solo cuando sea necesario
  let gsapLoaded = false;
  let gsapObserver: IntersectionObserver | null = null;
  
  async function initServicesScroll() {
    if (window.innerWidth <= 768 || gsapLoaded) return;
    gsapLoaded = true;
    
    const { gsap } = await import('gsap');
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector('#services') as HTMLElement;
    const content = document.querySelector('.services-scroll-content') as HTMLElement;
    if (!section || !content) return;

    const cards = content.querySelectorAll('.service-card');
    if (!cards.length) return;

    // Calculamos el ancho real del contenido
    const totalContentWidth = content.scrollWidth;
    const viewportWidth = window.innerWidth;
    
    // En simultáneo, queremos que las tarjetas se muevan de derecha a izquierda 
    // mientras la sección cruza la pantalla.
    const scrollDistance = totalContentWidth - (viewportWidth * 0.8);

    // Añadir clase para optimización durante animación
    content.classList.add('animating');
    
    // Empezamos con un pequeño offset positivo para que la primera tarjeta no esté pegada al borde
    gsap.set(content, { x: 100 });

    gsap.to(content, {
      x: -scrollDistance,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top bottom', // Empieza cuando el top entra por abajo
        end: 'bottom top',   // Termina cuando el bottom sale por arriba
        scrub: 1,
        invalidateOnRefresh: true,
        onUpdate: () => {
          if (!content.classList.contains('animating')) {
            content.classList.add('animating');
          }
        },
        onLeave: () => {
          content.classList.remove('animating');
        }
      }
    });
    
    // Optimizar resize con debounce
    let resizeTimeout: ReturnType<typeof setTimeout>;
    const handleResize = () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        ScrollTrigger.refresh();
      }, 150);
    };
    window.addEventListener('resize', handleResize, { passive: true });
    
    // Limpiar observer
    if (gsapObserver) {
      gsapObserver.disconnect();
      gsapObserver = null;
    }
  }
  
  // IntersectionObserver para lazy loading de GSAP
  document.addEventListener('DOMContentLoaded', () => {
    if (window.innerWidth <= 768) return;
    
    const container = document.querySelector('.services-scroll-container');
    if (!container) return;
    
    gsapObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          initServicesScroll();
        }
      });
    }, {
      rootMargin: '200px' // Cargar antes de que sea visible
    });
    
    gsapObserver.observe(container);
  });
</script>

