---
import ContactForm from './ContactForm';
---

<section
  class="mb-20 py-24 pt-32 md:pt-24 px-0 md:px-8 max-w-[1400px] mx-auto relative"
  id="contact"
>
  <div class="w-full md:w-4/5 mx-auto px-0 md:px-0">
    <!-- Header -->
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between mb-12 md:mb-16 gap-4 md:gap-6 px-4 md:px-0"
    >
      <div class="flex items-center gap-2">
        <span class="bg-gray-900 w-2 h-2 rounded-full"></span>
        <span class="text-sm font-medium text-gray-600">Somos tus aliados</span>
      </div>
      <h2
        class="text-[clamp(1.75rem,5vw,2.5rem)] font-extrabold text-gray-900 leading-tight"
      >
        Creamos soluciones, pero lo más importante es que identificamos
        problemas.
      </h2>
    </div>

    <!-- Main Form Card -->
    <div
      class="bg-white border border-gray-200 rounded-3xl p-6 md:p-8 lg:p-12 shadow-lg w-full"
      id="contact-form-container"
    >
      <!-- Header del formulario -->
      <div class="mb-8 md:mb-12">
          <button 
            type="button"
          class="bg-gray-100 text-gray-900 px-6 py-3 rounded-full text-sm font-medium hover:bg-gray-200 transition-colors mb-6"
          >
            Contáctanos
          </button>
        <h3
          class="text-[clamp(2rem,5vw,3.5rem)] font-extrabold text-gray-900 leading-tight"
        >
          ¿Hablamos de tu reto?
          </h3>
        </div>

      <ContactForm client:load />
    </div>
  </div>
</section>
