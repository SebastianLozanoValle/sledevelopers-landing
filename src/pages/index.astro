---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import Pricing from '../components/Pricing.astro';
import ServicesAccordion from '../components/ServicesAccordion.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import "../styles/global.css";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" href="/favicon-small.png" />
		<link rel="apple-touch-icon" href="/favicon-small.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Basics -->
		<title>SLE Development - Desarrollo Web y Soluciones Digitales</title>
		<meta name="description" content="Especialistas en desarrollo web, software a medida e inteligencia artificial. Creamos soluciones digitales que transforman y escalan tu negocio." />
		<meta name="keywords" content="desarrollo web, software, IA, inteligencia artificial, marketing digital, transformación digital" />
		<link rel="canonical" href="https://sledevelopers.com/" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://sledevelopers.com/" />
		<meta property="og:title" content="SLE Development - Desarrollo Web y Soluciones Digitales" />
		<meta property="og:description" content="Desarrollamos tecnología para que tu negocio escale. Soluciones en web, software e IA." />
		<meta property="og:image" content="https://sledevelopers.com/logo-optimized.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://sledevelopers.com/" />
		<meta property="twitter:title" content="SLE Development - Desarrollo Web y Soluciones Digitales" />
		<meta property="twitter:description" content="Desarrollamos tecnología para que tu negocio escale." />
		<meta property="twitter:image" content="https://sledevelopers.com/logo-optimized.png" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
		<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
	</head>
	<body class="font-['Inter',sans-serif] antialiased relative">
		<LoadingScreen />
		<div class="fixed inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(236,72,153,0.15),rgba(139,92,246,0.15),rgba(59,130,246,0.15))] blur-[100px] -z-10"></div>
		<Header />
		<main class="relative z-0">
			<Hero />
			<Services />
			<Portfolio />
			<ServicesAccordion />
			<Pricing />
			<Contact />
		</main>
		<Footer />
		<WhatsAppButton />
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: #ffffff;
		color: #1a1a1a;
		overflow-x: hidden;
	}

	h1, h2, h3, h4, h5, h6 {
		font-weight: 800;
		line-height: 1.2;
	}

	button {
		font-family: inherit;
	}

	a {
		text-decoration: none;
		color: inherit;
	}
</style>

